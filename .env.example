LISTINGS_API_BASE_URL=http://localhost:3000/api/v1/listings-platform
APP_URL=http://localhost:3001
DEMO_MODE=false
MEDIA_ALLOWED_HOSTS=
# Opcional: instância HTTPS própria/compatível do Overpass. Sem chave por padrão.
# NEXT_PUBLIC_OVERPASS_API_URL=https://overpass.private.coffee/api/interpreter

# Mapa aberto por padrão. Provedor gratuito ativo; Google só é carregado ao selecionar google.
NEXT_PUBLIC_MAPS_PROVIDER=openstreetmap
# Para Google: Maps JavaScript API + Places API (New), faturamento e chave restrita por referrer/APIs.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Server-only: same random value on Render and Vercel; authenticated client-IP forwarding.
# Required for property questions/audio and interest capture on Vercel. Never NEXT_PUBLIC_*.
# LISTINGS_BFF_SHARED_SECRET=
