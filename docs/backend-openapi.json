{
  "openapi": "3.0.3",
  "info": {
    "title": "ListingsPlatform Phase 1 API",
    "version": "1.0.0",
    "description": "Envelope: {data: object or array}; listing search also returns meta {page,per_page,has_more}. Error envelope: {error: {code,request_id}} or validation_failed with details. No ingestion, AI, voice, history or admin write API yet. All requests are JSON. Monetary decimals serialize as strings. Authentication endpoints: 20 requests per IP per 15 minutes; all endpoints: 120 requests per minute via host cache."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/v1/listings-platform/categories": {
      "get": {
        "summary": "Read up to 200 categories and their schemas",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Forbidden origin or unverified email"
          },
          "404": {
            "description": "Resource not found"
          },
          "422": {
            "description": "Validation failed or invalid/expired token"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "security": []
      }
    },
    "/api/v1/listings-platform/listings": {
      "get": {
        "summary": "Public listing search; unknown filters return 400, prices use the listing price basis. Specify currency and price_type is returned for interpretation.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Forbidden origin or unverified email"
          },
          "404": {
            "description": "Resource not found"
          },
          "422": {
            "description": "Validation failed or invalid/expired token"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "neighborhood",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "region",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "listing_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "availability",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "recent",
                "price_asc",
                "price_desc"
              ],
              "default": "recent"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      }
    },
