    "/api/v1/listings-platform/auth/register": {
      "post": {
        "summary": "Register independent member; sends verification email",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
